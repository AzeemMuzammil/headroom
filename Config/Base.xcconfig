// Signing and identity.
//
// The defaults build an ad-hoc signed app that runs on your own Mac with no Apple account.
// To sign with your own Apple Development certificate instead, copy Local.xcconfig.example to
// Local.xcconfig in this folder and fill it in. Local.xcconfig is gitignored.

PRODUCT_BUNDLE_IDENTIFIER = com.example.Headroom
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
